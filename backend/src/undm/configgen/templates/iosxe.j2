hostname {{ intent.hostname }}
{% for v in intent.vlans %}
vlan {{ v.vlan_id }}
{% if v.name %}
 name {{ v.name }}
{% endif %}
{% endfor %}
{% for i in intent.interfaces %}
interface {{ i.interface | iosxe_ifname }}
{% if i.description %}
 description {{ i.description }}
{% endif %}
 ip address {{ i.address.ip }} {{ i.address.netmask }}
 {{ "no shutdown" if i.enabled else "shutdown" }}
{% endfor %}
{% for r in intent.static_routes %}
ip route {{ r.prefix.network_address }} {{ r.prefix.netmask }}{% if r.egress_interface %} {{ r.egress_interface }}{% endif %} {{ r.next_hop }}
{% endfor %}
