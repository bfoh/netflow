# Copy to backend/.env and adjust. Never put real device credentials in this file.

# PostgreSQL (supported):
UNDM_DATABASE_URL=postgresql+psycopg://undm:undm@localhost:5432/undm
# Development-only fallback when PostgreSQL is not available:
# UNDM_DATABASE_URL=sqlite:///./undm-dev.db

# Require a different person to approve a deployment than the one who created it.
UNDM_REQUIRE_SEPARATE_APPROVER=false
# Simulated lab creates a factory-default simulated device on first contact.
UNDM_SIMULATION_AUTOCREATE=true
# Phase policy: production devices cannot be deployed to.
UNDM_ALLOW_PRODUCTION_DEPLOYMENTS=false
UNDM_LOG_LEVEL=INFO
